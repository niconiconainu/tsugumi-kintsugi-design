# =============================================================================
# Tsugumi — 環境変数テンプレート
#
# このファイルを `.env.local` にコピーして使う（`.env*` は .gitignore 済み）。
# すべてサーバー側でのみ読む。ブラウザへ露出させないため NEXT_PUBLIC_ は付けない。
# スキーマは src/config/env.schema.ts。
# =============================================================================

# -----------------------------------------------------------------------------
# 動作モード
# -----------------------------------------------------------------------------
# true  … AI Gateway が Mock 応答を返す（AI 未接続でもデモが最後まで動く）
# false … 実 API を呼ぶ。ただし呼び出し実装は未接続なので、現状は Mock へ落ちる
#         （src/infrastructure/ai/*.gateway.ts の TODO(AI) 参照）
DEMO_MODE=true

# -----------------------------------------------------------------------------
# Qwen Cloud（画像理解 / Vision）
#   DEMO_MODE=false のときだけ必要。
#   モデル名・Base URL は当日案内される値に合わせる（設計書 12.1）。
# -----------------------------------------------------------------------------
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_VISION_MODEL=qwen-vl-max

# -----------------------------------------------------------------------------
# GMI Cloud（OpenAI 互換の推論 API）
#   Design / Matcher / Copy でモデルを使い分ける（設計書 4.3）。
# -----------------------------------------------------------------------------
GMI_API_KEY=
GMI_BASE_URL=https://api.gmi-serving.com/v1
# 創造性重視（デザイン 3 案の生成）
GMI_DESIGN_MODEL=
# 推論・指示追従重視（工房との適合性の説明）
GMI_MATCHER_MODEL=
# 軽量・高速（カードの短い説明文）
GMI_COPY_MODEL=
