# =============================================================================
# Tsugumi — 環境変数テンプレート
#
# このファイルを `.env.local` にコピーして使う（`.env*` は .gitignore 済み）。
# すべてサーバー側でのみ読む。ブラウザへ露出させないため NEXT_PUBLIC_ は付けない。
# スキーマは src/config/env.schema.ts。
# =============================================================================

# -----------------------------------------------------------------------------
# 動作モード
# -----------------------------------------------------------------------------
# true  … AI Gateway が Mock 応答を返す（AI 未接続でもデモが最後まで動く）
# false … 実 API を呼ぶ。ただし呼び出し実装は未接続なので、現状は Mock へ落ちる
#         （src/infrastructure/ai/*.gateway.ts の TODO(AI) 参照）
DEMO_MODE=true

# -----------------------------------------------------------------------------
# Qwen Cloud（画像理解 + 画像編集）
#   DEMO_MODE=false のときだけ必要。
#   GMI Cloud に画像モデルが無いため、画像まわりは Qwen 側で完結させる。
# -----------------------------------------------------------------------------
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# step1: 金継ぎ可否の判定と、器の特徴の書き出し
QWEN_VISION_MODEL=qwen3-vl-plus
# step2: 写真そのものを編集して金継ぎ後の姿にする
#   OpenAI 互換ではなく DashScope ネイティブの
#   /api/v1/services/aigc/multimodal-generation/generation を叩く
QWEN_IMAGE_EDIT_MODEL=qwen-image-edit-max

# -----------------------------------------------------------------------------
# GMI Cloud（OpenAI 互換の推論 API）
#   画像モデルは提供されていないため、文章生成のみに使う。
# -----------------------------------------------------------------------------
GMI_API_KEY=
GMI_BASE_URL=https://api.gmi-serving.com/v1
# 軽量・高速（工房カードの短い説明文）
GMI_COPY_MODEL=google/gemini-3.6-flash
